# ThreatDesk Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.

# ── Gemma (via Google AI Studio / Gemini API) ──
GEMINI_API_KEY=
GEMMA_MODEL=
GEMMA_FALLBACK_MODEL=

# ── Snowflake ──
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=

# Authentication: fill ONE of the following groups.
# Option 1: Password
SNOWFLAKE_PASSWORD=

# Option 2: Key-pair (path to the private key file)
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Option 3: Programmatic access token
SNOWFLAKE_TOKEN=

# ── Roles ──
SNOWFLAKE_ADMIN_ROLE=
SNOWFLAKE_READONLY_ROLE=

# ── App settings ──
ROW_LIMIT=200
STATEMENT_TIMEOUT_SECONDS=30
CACHE_ENABLED=true
CONTEXT_TURNS=3

# ── Optional ──
NVD_API_KEY=
